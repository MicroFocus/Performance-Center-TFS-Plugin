<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PluginsUI</AssemblyName>
    <RootNamespace>PluginsUI</RootNamespace>
    <ApplicationIcon>Assets\PC.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0.0</Version>
    <Authors>OpenText</Authors>
    <Description>Standalone configurator UI for OpenText Enterprise Performance Engineering — runs the Node.js angular task locally.</Description>
    <Copyright>© Copyright 2001-2026 Open Text or one of its affiliates.</Copyright>
    <Product>OpenText Enterprise Performance Engineering Plugin</Product>
    <FileVersion>3.0.0.0</FileVersion>
    <Trademark>OpenText</Trademark>
    <Company>OpenText</Company>
  </PropertyGroup>

  <!-- Assets: images and scripts are copied to output directory -->
  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\run-lre-task.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\run-workspace-sync.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\run-download-scripts.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\test-connection.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UserGuide.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Builds the Angular/TypeScript tasks and stages the compiled artifacts into the
    build output directory so PluginsUI.exe can run the Node.js tasks without a
    separate installation step.

    Implemented as a Node.js script (angular/scripts/stage-pluginui.js) — the same
    pattern used by "npm run package:vsix".  The script handles:
      • npm install  (only when node_modules is absent)
      • npm run build  (tsc incremental — only recompiles changed files)
      • Per-task index.js + dist/ copy (mtime-based, skips unchanged files)
      • Shared node_modules mirror (robocopy /XO — skips files that are up-to-date)

    Skip flags (MSBuild command-line):
      /p:SkipAngularBuild=true   - passes the skip-build flag to the script (copy only, no tsc)
      /p:SkipAngularCopy=true    - skips this target entirely

    Layout in output:
      <OutputDir>/
        node_modules/
        LreCiTask/        index.js  dist/
        LreWorkspaceSyncTask/   index.js  dist/
        LreDownloadScriptsTask/ index.js  dist/
  -->
  <Target Name="StageAngularTasks" AfterTargets="Build"
          Condition="'$(SkipAngularCopy)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\..\angular\package.json')">

    <PropertyGroup>
      <AngularRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\angular'))</AngularRoot>
      <!-- Trim trailing backslash before quoting — a path ending in \ followed by " causes
           the shell to interpret the " as a literal character, corrupting the argument. -->
      <_OutDir>$([System.IO.Path]::GetFullPath('$(OutputPath)').TrimEnd('\').TrimEnd('/'))</_OutDir>
      <_StagingArgs>"$(_OutDir)"</_StagingArgs>
      <_StagingArgs Condition="'$(SkipAngularBuild)' == 'true'">$(_StagingArgs) --skip-build</_StagingArgs>
    </PropertyGroup>

    <Exec Command="node &quot;scripts/stage-pluginui.js&quot; $(_StagingArgs)"
          WorkingDirectory="$(AngularRoot)" />

  </Target>

  <!--
    Workaround: HeatWave (WiX VS extension) is not yet compatible with VS 2026.
    VS skips PluginsInstaller.wixproj during solution builds.
    This target invokes it directly via MSBuild after PluginsUI is built.
    Set SkipInstallerBuild=true on the command line to suppress it (e.g. in CI).
  -->
  <Target Name="BuildInstaller" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(SkipInstallerBuild)' != 'true'">
    <Message Importance="high" Text="--- Building PluginsInstaller (WiX) ---" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\PluginsInstaller\PluginsInstaller.wixproj"
             Properties="Configuration=$(Configuration)"
             Targets="Build" />
  </Target>

</Project>
